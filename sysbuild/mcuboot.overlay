/*
 * MCUboot Overlay for AutoWatering
 * - USB CDC ACM for serial recovery
 * - External W25Q128 flash support (slot1/scratch)
 */

/ {
    chosen {
        zephyr,console = &cdc_acm_uart0;
        zephyr,uart-mcumgr = &uart0;
        zephyr,boot-mode = &boot_mode0;
        /* Link MCUboot at 0x0 so the vector table is at the CPU reset address.
           Without this, the board default code_partition at 0x10000 is used,
           requiring the Arduino bootloader to redirect to MCUboot. */
        zephyr,code-partition = &boot_partition;
    };
};

&uart0 {
    status = "okay";
    pinctrl-0 = <&uart0_host_default>;
    pinctrl-1 = <&uart0_host_sleep>;
    pinctrl-names = "default", "sleep";
};

&gpregret1 {
    boot_mode0: boot_mode@0 {
        compatible = "zephyr,retention";
        status = "okay";
        reg = <0x0 0x1>;
    };
};

/* ---------- USB CDC ACM for serial recovery ---------- */
&zephyr_udc0 {
    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
    };
};

/* ---------- pinctrl for SPI2 (W25Q128 external flash) ---------- */
&pinctrl {
    uart0_host_default: uart0_host_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 3)>,
                    <NRF_PSEL(UART_RX, 1, 10)>;
        };
    };

    uart0_host_sleep: uart0_host_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 3)>,
                    <NRF_PSEL(UART_RX, 1, 10)>;
            low-power-enable;
        };
    };

    spi2_default: spi2_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 15)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 13)>,
                    <NRF_PSEL(SPIM_MISO, 1, 14)>;
        };
    };

    spi2_sleep: spi2_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 15)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 13)>,
                    <NRF_PSEL(SPIM_MISO, 1, 14)>;
            low-power-enable;
        };
    };
};

/* ---------- SPI2 for W25Q128 external flash (MCUboot needs this too) ---------- */
&spi2 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi2_default>;
    pinctrl-1 = <&spi2_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 23 GPIO_ACTIVE_LOW>;

    w25q128: w25q128@0 {
        compatible = "jedec,spi-nor";
        reg = <0>;
        spi-max-frequency = <40000000>;
        jedec-id = [ef 40 18];
        size = <DT_SIZE_M(128)>;  /* 128 Mbit = 16 MB */
        has-dpd;
        t-enter-dpd = <3000>;
        t-exit-dpd = <30000>;

        partitions {
            compatible = "fixed-partitions";
            #address-cells = <1>;
            #size-cells = <1>;

            /*
             * Slot 1 starts at 0x23000 so its offset exceeds
             * CONFIG_FLASH_LOAD_OFFSET (0x22000).  Prevents MCUmgr
             * from treating slot1 as the running partition.
             */
            slot1_partition: partition@23000 {
                label = "image-1";
                reg = <0x00023000 0x000B6000>;
            };

            /* Scratch partition for MCUboot swap (128 KB) */
            scratch_partition: partition@D9000 {
                label = "image-scratch";
                reg = <0x000D9000 0x00020000>;
            };
        };
    };
};

/* ---------- Internal flash partitions for MCUboot ---------- */
&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        /* MCUboot bootloader (136 KB – Arduino BL 64 KB + MCUboot 72 KB) */
        boot_partition: partition@0 {
            label = "mcuboot";
            reg = <0x00000000 0x00022000>;  /* 136 KB */
        };

        /* Primary application slot (slot0) */
        slot0_partition: partition@22000 {
            label = "image-0";
            reg = <0x00022000 0x000B6000>;  /* 728 KB */
        };
    };
};
