mainmenu "AutoWatering"

source "Kconfig.zephyr"

menu "AutoWatering options"

config AUTOWATERING_PM_SUPPORT
    bool "Enable AutoWatering power management glue"
    default y
    select HAS_PM

config HISTORY_EXTERNAL_FLASH
    bool "Store history data on external flash"
    default n
    depends on FLASH_MAP && SPI_NOR
    help
      When enabled, environmental and rain history data is stored on
      external SPI flash using LittleFS instead of RAM buffers.
      This saves approximately 74KB of RAM but requires an external
      flash chip (W25Q128 or similar) to be configured.

      Affected modules:
      - environmental_history: ~46KB RAM saved
      - rain_history: ~28KB RAM saved

config AUTOWATERING_UCP_UART
    bool "Enable UCP UART v1 protocol server (ESP32 / UART peer)"
    default y
    depends on SERIAL
    help
      Enables the custom UCP UART v1 protocol server on uart0.
      Current implementation includes:
      - framing (COBS + CRC32C)
      - HELLO/PING handshake
      - GET/SET/CMD/SUB/UNSUB dispatch
      - async EVENT_CHANGE and EVENT_HEARTBEAT
      - real resources: device.system_status, rtc_tz.timezone_config
      - OTA command stubs (preflight/post_check, enter_recovery placeholder)

endmenu
